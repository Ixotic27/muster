            <mxPoint as="targetPoint" x="1092" y="1517" />
          </mxGeometry>
        </mxCell>
        <mxCell id="text16" value="PK = document identifier   UQ = unique index   FK = logical ObjectId reference   ? = nullable / optional" vertex="1" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#203044;fontStyle=0;">
          <mxGeometry as="geometry" x="60" y="1544" width="893.6" height="23" />
        </mxCell>
        <mxCell id="text17" value="Dashed = non-identifying reference; each document has its own _id. Solid = embedded ownership, not a separate collection." vertex="1" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#203044;fontStyle=0;">
          <mxGeometry as="geometry" x="60" y="1575" width="1036.4" height="23" />
        </mxCell>
        <mxCell id="text18" value="Composite UQ: Registration(eventId, leaderId); Registration(eventId, teamId) when teamId exists; Pass(registrationId, userId); Team(teamName, eventId)." vertex="1" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#556577;fontStyle=0;">
          <mxGeometry as="geometry" x="60" y="1611" width="1288.3999999999999" height="23" />
        </mxCell>
        <mxCell id="text19" value="Registration.paymentId and GatewayOrder.paymentId select a receipt; they do not replace Payment history. A manual receipt may have no gateway order." vertex="1" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#556577;fontStyle=0;">
          <mxGeometry as="geometry" x="60" y="1640" width="1263.2" height="23" />
        </mxCell>
        <mxCell id="text20" value="Team ↔ Registration is optional on both sides; solo registrations have no team. Team membership is detailed in the supporting view." vertex="1" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#556577;fontStyle=0;">
          <mxGeometry as="geometry" x="60" y="1669" width="1120.3999999999999" height="23" />
        </mxCell>
        <mxCell id="text21" value="Only lifecycle relationships are drawn. Other role-based refs remain in rows; the documentation catalogs every ObjectId relationship." vertex="1" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#556577;fontStyle=0;">
          <mxGeometry as="geometry" x="60" y="1698" width="1137.2" height="23" />
        </mxCell>
        <mxCell id="text22" value="FK denotes an application reference, not an SQL foreign-key constraint. Required refs plus service consistency define logical cardinality." vertex="1" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#556577;fontStyle=0;">
          <mxGeometry as="geometry" x="60" y="1727" width="1179.2" height="23" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
