          <mxGeometry as="geometry" x="60" y="1143" width="144.8" height="25" />
        </mxCell>
        <mxCell id="text49" value="Rectangle = entity   Diamond = relationship   Oval = attribute   Underlined attribute = primary identifier" vertex="1" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#203044;fontStyle=0;">
          <mxGeometry as="geometry" x="60" y="1181" width="1037.6" height="25" />
        </mxCell>
        <mxCell id="text50" value="Single line = partial (optional) participation; double line = total (required) participation." vertex="1" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#203044;fontStyle=0;">
          <mxGeometry as="geometry" x="60" y="1212" width="912.8" height="25" />
        </mxCell>
        <mxCell id="text51" value="(min,max) at an entity end counts its participation in that relationship. N means many; these are not flow arrows." vertex="1" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#203044;fontStyle=0;">
          <mxGeometry as="geometry" x="60" y="1243" width="1114.3999999999999" height="25" />
        </mxCell>
        <mxCell id="text52" value="Solo registrations have no Team. Each Pass belongs to one person; (registrationId, userId) is unique. Free entries need no Payment." vertex="1" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#556577;fontStyle=0;">
          <mxGeometry as="geometry" x="60" y="1280" width="1199.0" height="24" />
        </mxCell>
        <mxCell id="text53" value="Registration has receipt history, not a mandatory 1:1 payment. Technical gateway, invitations, outbox and embedded membership are in the physical views." vertex="1" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#556577;fontStyle=0;">
          <mxGeometry as="geometry" x="60" y="1312" width="1388.0" height="24" />
        </mxCell>
