        <mxCell id="text18" value="PK = document identifier   UQ = unique index   FK = logical ObjectId reference   ? = nullable / optional" vertex="1" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#203044;fontStyle=0;">
          <mxGeometry as="geometry" x="60" y="1304" width="893.6" height="23" />
        </mxCell>
        <mxCell id="text19" value="Dashed = non-identifying reference; each document has its own _id. Solid = embedded ownership, not a separate collection." vertex="1" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#203044;fontStyle=0;">
          <mxGeometry as="geometry" x="60" y="1335" width="1036.4" height="23" />
        </mxCell>
        <mxCell id="text20" value="Team.members[] and closedRoster[] are embedded values. Team.members.userId is indexed with eventId but is NOT unique or a member primary key." vertex="1" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#556577;fontStyle=0;">
          <mxGeometry as="geometry" x="60" y="1371" width="1204.3999999999999" height="23" />
        </mxCell>
        <mxCell id="text21" value="An invite may target an unregistered email, so invitedUser is nullable. Pending (teamId, invitedEmail) uniqueness uses a partial index." vertex="1" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#556577;fontStyle=0;">
          <mxGeometry as="geometry" x="60" y="1400" width="1154.0" height="23" />
        </mxCell>
        <mxCell id="text22" value="EmailJob may exist without a Notification or registered recipient. Neither optional reference is unique: the physical model allows many jobs." vertex="1" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#556577;fontStyle=0;">
          <mxGeometry as="geometry" x="60" y="1429" width="1204.3999999999999" height="23" />
        </mxCell>
        <mxCell id="text23" value="Other EmailJob and Notification subject refs are shown in rows; contextual links do not establish required parent relationships." vertex="1" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#556577;fontStyle=0;">
          <mxGeometry as="geometry" x="60" y="1458" width="1095.2" height="23" />
        </mxCell>
        <mxCell id="text24" value="Operational collections and polymorphic audit targets are omitted here; see the full relationship catalog." vertex="1" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#556577;fontStyle=0;">
          <mxGeometry as="geometry" x="60" y="1487" width="910.4" height="23" />
        </mxCell>
