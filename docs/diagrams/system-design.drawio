 y="150" /></Array></mxGeometry></mxCell><mxCell id="edge9" value="independent scheduled retry" edge="1" parent="1" source="operations" target="worker" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8293ad;endArrow=block;endFill=1;fontSize=13;fontColor=#52627a;labelBackgroundColor=#f4f7fb;dashed=1;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1010" y="1090" /><mxPoint x="1010" y="770" /></Array></mxGeometry></mxCell><mxCell id="browser" value="&lt;b&gt;Participants &amp;amp; staff&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Browse / account / teams&lt;br/&gt;Registration &amp;amp; checkout&lt;br/&gt;My passes / staff scanner&lt;br/&gt;Admin / event manager" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2855d9;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacing=20;fontFamily=Arial;fontSize=15;fontColor=#14233b;"><mxGeometry as="geometry" x="60" y="190" width="330" height="215" /></mxCell><mxCell id="api" value="&lt;b&gt;Express API&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Authentication + role scope&lt;br/&gt;Event / team / registration&lt;br/&gt;Gateway verification + refunds&lt;br/&gt;Private files + signed passes" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2855d9;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacing=20;fontFamily=Arial;fontSize=15;fontColor=#14233b;"><mxGeometry as="geometry" x="530" y="190" width="400" height="215" /></mxCell><mxCell id="db" value="&lt;b&gt;MongoDB replica set&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Users / events / teams&lt;br/&gt;Registration / payment / passes&lt;br/&gt;Notifications + durable outbox&lt;br/&gt;Transactions + unique indexes" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#087f78;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacing=20;fontFamily=Arial;fontSize=15;fontColor=#14233b;"><mxGeometry as="geometry" x="1110" y="190" width="350" height="215" /></mxCell><mxCell id="checkout" value="&lt;b&gt;Razorpay Checkout&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Hosted payment interface&lt;br/&gt;Public key + server order&lt;br/&gt;Browser callback is untrusted&lt;br/&gt;No card data stored locally" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#087f78;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacing=20;fontFamily=Arial;fontSize=15;fontColor=#14233b;"><mxGeometry as="geometry" x="60" y="610" width="330" height="215" /></mxCell><mxCell id="provider" value="&lt;b&gt;Razorpay API &amp;amp; webhook&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Server creates amount/order&lt;br/&gt;Verify capture + order + currency&lt;br/&gt;Raw-body webhook signature&lt;br/&gt;Idempotent local settlement" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#087f78;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacing=20;fontFamily=Arial;fontSize=15;fontColor=#14233b;"><mxGeometry as="geometry" x="530" y="610" width="400" height="215" /></mxCell><mxCell id="worker" value="&lt;b&gt;Email dispatcher / worker&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Commit first → deliver second&lt;br/&gt;Lease / retry / expiry / dedupe&lt;br/&gt;Recheck recipient access&lt;br/&gt;One job per lifecycle message" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a6640c;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacing=20;fontFamily=Arial;fontSize=15;fontColor=#14233b;"><mxGeometry as="geometry" x="1110" y="610" width="350" height="215" /></mxCell><mxCell id="mail" value="&lt;b&gt;Configured SMTP provider&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;TLS + verified sender domain&lt;br/&gt;Responsive HTML + plain text&lt;br/&gt;Receipt / pass / invite / reset&lt;br/&gt;Delivery depends on provider" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a6640c;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacing=20;fontFamily=Arial;fontSize=15;fontColor=#14233b;"><mxGeometry as="geometry" x="1110" y="1000" width="350" height="210" /></mxCell><mxCell id="scanner" value="&lt;b&gt;Authorized event scanner&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Camera / image / typed token&lt;br/&gt;Validate signature &amp;amp; live status&lt;br/&gt;Atomic first check-in wins&lt;br/&gt;Event-scoped staff access" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7951b0;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacing=20;fontFamily=Arial;fontSize=15;fontColor=#14233b;"><mxGeometry as="geometry" x="60" y="1000" width="330" height="210" /></mxCell><mxCell id="operations" value="&lt;b&gt;Operator configuration&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Secrets only on backend&lt;br/&gt;HTTPS / exact origins / backups&lt;br/&gt;Worker scheduling + health&lt;br/&gt;Manual refund evidence" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7951b0;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacing=20;fontFamily=Arial;fontSize=15;fontColor=#14233b;"><mxGeometry as="geometry" x="530" y="1000" width="400" height="210" /></mxCell><mxCell id="note0" value="Payment settlement and email enqueue are transactional. A callback or webhook replay must not duplicate passes or mail." vertex="1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#14233b;fontStyle=0;"><mxGeometry as="geometry" x="60" y="1260" width="1400" height="45" /></mxCell><mxCell id="note1" value="Request-time mail delivery is best effort; a separately scheduled worker retries persisted jobs after failures." vertex="1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#14233b;fontStyle=0;"><mxGeometry as="geometry" x="60" y="1300" width="1400" height="45" /></mxCell><mxCell id="note2" value="Optional manual payment/document review remains available. No real payment credentials or participant data ship with this template." vertex="1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#14233b;fontStyle=0;"><mxGeometry as="geometry" x="60" y="1340" width="1400" height="45" /></mxCell></root></mxGraphModel></diagram></mxfile>