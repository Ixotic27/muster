<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="system-design" name="Muster | Container architecture (C4 · Level 2)"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1930" pageHeight="1500"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Muster | Container architecture (C4 · Level 2)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=28;fontColor=#526174;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="34" width="1810" height="40" /></mxCell><mxCell id="subtitle" value="Backend building blocks and integration boundaries. The included frontend is a replaceable demonstration and checking client." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#526174;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="83" width="1810" height="35" /></mxCell><mxCell id="owned" value="MUSTER BACKEND · logical ownership boundary" style="rounded=0;html=1;fillColor=none;strokeColor=#748193;dashed=1;dashPattern=8 5;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fontFamily=Arial;fontSize=16;fontStyle=1;fontColor=#142438;" vertex="1" parent="1"><mxGeometry as="geometry" x="790" y="150" width="1080" height="870" /></mxCell><mxCell id="users" value="" style="rounded=0;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="255" width="200" height="230" /></mxCell><mxCell id="users-symbol" value="" style="shape=umlActor;html=1;strokeColor=#142438;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="98.0" y="255" width="54" height="95" /></mxCell><mxCell id="users-name" value="Participants / staff" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#142438;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="360" width="200" height="28" /></mxCell><mxCell id="users-type" value="[Person]" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#526174;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="389" width="200" height="24" /></mxCell><mxCell id="users-body0" value="Role-scoped workflows" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#526174;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="421" width="200" height="24" /></mxCell><mxCell id="users-body1" value="Scanner is a staff UI" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#526174;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="445" width="200" height="24" /></mxCell><mxCell id="web" value="&lt;b&gt;Reference frontend&lt;/b&gt;&lt;br/&gt;[Demo client · React 18 / Vite]&lt;br/&gt;&lt;br/&gt;Replaceable API consumer&lt;br/&gt;Static bundle; runs in user&amp;#x27;s browser&lt;br/&gt;Checks registration / staff workflows&lt;br/&gt;Hosts Razorpay Checkout&lt;br/&gt;Camera / image QR scanning" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f1f6f8;strokeColor=#25547c;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#142438;align=center;verticalAlign=middle;spacing=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="330" y="240" width="340" height="290" /></mxCell><mxCell id="api" value="&lt;b&gt;Application API&lt;/b&gt;&lt;br/&gt;[Container · Node.js / Express]&lt;br/&gt;&lt;br/&gt;Single modular monolith&lt;br/&gt;JWT cookie / bearer + live user check&lt;br/&gt;Role and assigned-event authorization&lt;br/&gt;Registration / payment / pass services&lt;br/&gt;Signature + provider capture checks&lt;br/&gt;Atomic settlement and first check-in&lt;br/&gt;Outbox insertion + post-commit send" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f1f6f8;strokeColor=#25547c;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#142438;align=center;verticalAlign=middle;spacing=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="830" y="240" width="400" height="370" /></mxCell><mxCell id="db" value="&lt;b&gt;Application database&lt;/b&gt;&lt;br/&gt;[Container · MongoDB replica set]&lt;br/&gt;&lt;br/&gt;Users, events, teams, registrations&lt;br/&gt;Gateway orders, receipts, passes&lt;br/&gt;Notifications, EmailJob outbox&lt;br/&gt;Transactions and unique indexes&lt;br/&gt;Leases / retries / audit records" style="shape=cylinder3;boundedLbl=1;size=20;html=1;whiteSpace=wrap;fillColor=#f1f6f8;strokeColor=#1e706a;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#142438;align=center;verticalAlign=middle;spacing=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="1430" y="240" width="380" height="290" /></mxCell><mxCell id="worker" value="&lt;b&gt;Email worker&lt;/b&gt;&lt;br/&gt;[Container · Node.js process]&lt;br/&gt;&lt;br/&gt;Polls durable EmailJob outbox&lt;br/&gt;Leases, retry, deduplication&lt;br/&gt;Rechecks current access / expiry&lt;br/&gt;Shared email renderer + processor&lt;br/&gt;Continuous poll or one-shot job" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f1f6f8;strokeColor=#25547c;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#142438;align=center;verticalAlign=middle;spacing=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="1430" y="720" width="380" height="250" /></mxCell><mxCell id="oauth" value="&lt;b&gt;Google Identity&lt;/b&gt;&lt;br/&gt;[External system · optional]&lt;br/&gt;&lt;br/&gt;OAuth 2.0 · verified email&lt;br/&gt;Signed state checked by API&lt;br/&gt;Enabled only with configured keys" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f4f4f4;strokeColor=#5c6570;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#142438;align=center;verticalAlign=middle;spacing=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="330" y="590" width="330" height="175" /></mxCell><mxCell id="custom" value="&lt;b&gt;Adopter-built client&lt;/b&gt;&lt;br/&gt;[Integration option · not shipped]&lt;br/&gt;&lt;br/&gt;Custom web / mobile / staff client&lt;br/&gt;Uses the same authenticated API&lt;br/&gt;Backend rules remain authoritative" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f4f4f4;strokeColor=#5c6570;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#142438;align=center;verticalAlign=middle;spacing=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="330" y="815" width="340" height="175" /></mxCell><mxCell id="razorpay" value="&lt;b&gt;Razorpay&lt;/b&gt;&lt;br/&gt;[External system]&lt;br/&gt;&lt;br/&gt;Hosted Checkout + payment API&lt;br/&gt;Orders use server-owned amount&lt;br/&gt;Raw-body signed webhook events&lt;br/&gt;Test mode is the template default" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f4f4f4;strokeColor=#5c6570;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#142438;align=center;verticalAlign=middle;spacing=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="830" y="1140" width="380" height="220" /></mxCell><mxCell id="smtp" value="&lt;b&gt;SMTP provider&lt;/b&gt;&lt;br/&gt;[External system]&lt;br/&gt;&lt;br/&gt;SMTP over TLS / STARTTLS&lt;br/&gt;Configured sender identity&lt;br/&gt;HTML + plain text / QR attachment&lt;br/&gt;Messages leave after commit" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f4f4f4;strokeColor=#5c6570;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#142438;align=center;verticalAlign=middle;spacing=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="1430" y="1140" width="380" height="220" /></mxCell><mxCell id="user-web" edge="1" parent="1" source="users" target="web" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#25547c;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;dashed=0;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.4482758620689655;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="user-web-label0" value="Uses" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#25547c;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="230" y="333" width="85" height="25" /></mxCell><mxCell id="web-api" edge="1" parent="1" source="web" target="api" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#25547c;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;dashed=0;exitX=1.0;exitY=0.4482758620689655;entryX=0.0;entryY=0.35135135135135137;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="web-api-label0" value="HTTPS /api/v1" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#25547c;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="675" y="308" width="150" height="25" /></mxCell><mxCell id="web-api-label1" value="JWT cookie / bearer" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#25547c;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="675" y="336" width="150" height="25" /></mxCell><mxCell id="web-api-label2" value="Socket.IO notifications" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#25547c;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="673" y="386" width="154" height="25" /></mxCell><mxCell id="web-checkout" edge="1" parent="1" source="web" target="razorpay" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#25547c;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;dashed=0;exitX=0.0;exitY=0.7931034482758621;entryX=0.0;entryY=0.4772727272727273;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="270" y="470" /><mxPoint x="270" y="1245" /></Array></mxGeometry></mxCell><mxCell id="web-checkout-label0" value="Hosted Checkout / HTTPS" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#25547c;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="360" y="1160" width="350" height="25" /></mxCell><mxCell id="web-checkout-label1" value="Public key + server-created order" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#25547c;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="335" y="1191" width="400" height="25" /></mxCell><mxCell id="api-db" edge="1" parent="1" source="api" target="db" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1e706a;strokeWidth=2;endArrow=block;endFill=1;startArrow=block;startFill=1;dashed=0;exitX=1.0;exitY=0.35135135135135137;entryX=0.0;entryY=0.4482758620689655;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="api-db-label0" value="Mongoose / Mongo wire" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#1e706a;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="1235" y="328" width="190" height="25" /></mxCell><mxCell id="api-db-label1" value="Read / write / transaction" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#1e706a;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="1235" y="388" width="190" height="25" /></mxCell><mxCell id="worker-db" edge="1" parent="1" source="worker" target="db" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1e706a;strokeWidth=2;endArrow=block;endFill=1;startArrow=block;startFill=1;dashed=0;exitX=0.5;exitY=0.0;entryX=0.5;entryY=1.0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="worker-db-label0" value="Claim / update EmailJob" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#1e706a;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="1465" y="578" width="310" height="25" /></mxCell><mxCell id="worker-db-label1" value="WorkerLease + delivery status" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#1e706a;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="1450" y="609" width="340" height="25" /></mxCell><mxCell id="worker-smtp" edge="1" parent="1" source="worker" target="smtp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5c6570;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;dashed=1;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="worker-smtp-label0" value="Background send / retry" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#5c6570;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="1470" y="1058" width="310" height="25" /></mxCell><mxCell id="api-smtp" edge="1" parent="1" source="api" target="smtp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5c6570;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;dashed=1;exitX=1.0;exitY=0.8918918918918919;entryX=0.0;entryY=0.4772727272727273;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1300" y="570" /><mxPoint x="1300" y="1245" /></Array></mxGeometry></mxCell><mxCell id="api-smtp-label0" value="Post-commit send attempt" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#5c6570;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="1210" y="802" width="220" height="25" /></mxCell><mxCell id="api-smtp-label1" value="(awaited, best effort)" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#5c6570;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="1217" y="831" width="210" height="25" /></mxCell><mxCell id="api-orders" edge="1" parent="1" source="api" target="razorpay" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#25547c;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;dashed=0;exitX=0.25;exitY=1.0;entryX=0.2631578947368421;entryY=0.0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="api-orders-label0" value="Create order / fetch capture" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#25547c;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="805" y="738" width="250" height="25" /></mxCell><mxCell id="api-orders-label1" value="HTTPS + server credentials" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#25547c;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="805" y="767" width="250" height="25" /></mxCell><mxCell id="payment-webhook" edge="1" parent="1" source="razorpay" target="api" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5c6570;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;dashed=1;exitX=0.7631578947368421;exitY=0.0;entryX=0.725;entryY=1.0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="payment-webhook-label0" value="POST /payments/gateway/webhook" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#5c6570;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="999" y="934" width="288" height="25" /></mxCell><mxCell id="payment-webhook-label1" value="HMAC(raw body) → API re-fetch" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#5c6570;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="997" y="963" width="290" height="25" /></mxCell><mxCell id="api-google" edge="1" parent="1" source="api" target="oauth" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#25547c;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;dashed=0;exitX=0.0;exitY=0.6756756756756757;entryX=1.0;entryY=0.4857142857142857;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="740" y="490" /><mxPoint x="740" y="675" /></Array></mxGeometry></mxCell><mxCell id="api-google-label0" value="OAuth / HTTPS" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#25547c;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="668" y="585" width="140" height="25" /></mxCell><mxCell id="custom-api" edge="1" parent="1" source="custom" target="api" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#25547c;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;dashed=0;exitX=1.0;exitY=0.4857142857142857;entryX=0.0;entryY=0.8648648648648649;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="775" y="900" /><mxPoint x="775" y="560" /></Array></mxGeometry></mxCell><mxCell id="custom-api-label0" value="REST /api/v1" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#25547c;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="680" y="911" width="105" height="25" /></mxCell><mxCell id="sharednote" value="API and worker share the queue processor. MongoDB stores the outbox; there is no separate message broker." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#526174;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="192" width="1030" height="25" /></mxCell><mxCell id="legendtitle" value="Notation" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#142438;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="1390" width="160" height="25" /></mxCell><mxCell id="legend" value="Blue solid: synchronous request · Teal solid: database I/O (both ways) · Grey dashed: payment webhook / email delivery" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#526174;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="1390" width="1620" height="25" /></mxCell><mxCell id="trust" value="Trust: browser payment callbacks do not settle a registration; the API verifies order, amount, currency, signature and capture." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#526174;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="1430" width="1800" height="25" /></mxCell><mxCell id="deployment" value="Deployment: API runtime + worker/scheduler + MongoDB replica set. Host the reference frontend only when needed; no cloud vendor is required." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#526174;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="1463" width="1800" height="25" /></mxCell></root></mxGraphModel></diagram></mxfile>