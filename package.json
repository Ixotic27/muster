{
  "name": "muster",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable event-management backend with a reference web client",
  "license": "ISC",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "install:all": "npm ci --prefix backend && npm ci --prefix frontend",
    "dev:api": "npm run dev --prefix backend",
    "dev:web": "npm start --prefix frontend",
    "build": "npm run build --prefix frontend",
    "test:privacy": "node scripts/check-publication.js",
    "test:architecture": "python scripts/check-architecture.py",
    "diagrams": "python scripts/generate-diagrams.py"
  }
}
