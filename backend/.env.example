# Copy to .env. Never commit your .env or any real credentials.
NODE_ENV=development
PORT=5000
# Transactions require MongoDB replica-set mode, including for local development.
MONGODB_URI=mongodb://127.0.0.1:27017/muster?replicaSet=rs0
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_MAX_POOL_SIZE=20
FRONTEND_URL=http://127.0.0.1:4120
FRONTEND_ORIGINS=http://127.0.0.1:4120
FRONTEND_AUTH_SUCCESS_URL=http://127.0.0.1:4120/dashboard
BRAND_NAME=Muster
EVENT_TIMEZONE=UTC
SUPPORT_EMAIL=
# Generate independent random values: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
QR_SIGN_SECRET=
JWT_EXPIRES_IN=15m
JWT_COOKIE_MAX_AGE_MS=86400000
# Set only to the number of trusted reverse proxies in your actual deployment.
TRUST_PROXY_HOPS=0
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
# Sign up first, then set your account email and run npm run bootstrap:admin.
BOOTSTRAP_ADMIN_EMAIL=
SUPER_ADMIN_EMAILS=
ENABLE_DEV_LOGIN=false
ALLOW_SAMPLE_SEED=false

# Gateway remains unavailable until valid test credentials are configured.
PAYMENT_TEST_MODE=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Manual UPI proof review is optional and disabled by default.
ENABLE_MANUAL_PAYMENTS=false
PAYMENT_UPI_ID=
PAYMENT_UPI_NAME=
REFUND_CUTOFF_HOURS=48

# Choose disabled (default) or smtp. No real messages are sent by default.
EMAIL_PROVIDER=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=
SMTP_SENDER_INTERVAL_SECONDS=1
SMTP_DAILY_LIMIT=100
# Independent random secret for the protected scheduled worker endpoint.
EMAIL_WORKER_SECRET=
EMAIL_WORKER_POLL_MS=15000

# Optional Google OAuth; use the exact registered callback URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Keep the callback on the same browser origin as /auth/google. The local web
# server proxies /api to the API, preserving the OAuth state cookie.
GOOGLE_CALLBACK_URL=http://127.0.0.1:4120/api/v1/auth/google/callback
# Optional Cloudinary event banners. Private payment/document uploads stay access-controlled.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
