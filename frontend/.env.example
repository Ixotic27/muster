# Public browser settings only. Never put API secrets in this file.
REACT_APP_SITE_NAME=EventFlow
REACT_APP_SITE_TAGLINE=Good events start with a clear plan.
REACT_APP_SUPPORT_EMAIL=
REACT_APP_LOCALE=en-IN
REACT_APP_TIMEZONE=UTC
# Relative API URL supports same-origin cookie sessions in production.
REACT_APP_API_URL=/api/v1
# Development proxy only; change this to your local backend port.
REACT_APP_BACKEND_URL=http://127.0.0.1:5000
